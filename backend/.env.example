# Supabase Postgres: Connect > Session pooler (port 5432)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
# Required: secret for signing login tokens, at least 32 characters
# Generate one: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:3000
