# # ---- Mock mode (default): no backend or Supabase needed ----
# NEXT_PUBLIC_API_BASE_URL=/mock-api
# # Mock only: accept orders at any time (ignores 10:00-16:00 and rush hour)
# MOCK_IGNORE_HOURS=true

# # ---- Real backend: fill these, then restart `npm run dev` ----
# # NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# # Supabase Dashboard > Project Settings > API (same project as the backend's SUPABASE_URL)
# # NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# # NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
