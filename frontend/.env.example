# Copy to .env.local only if you need to change something. With no .env.local the
# frontend talks to the Spring Boot backend at http://localhost:8080/api.

# Use the built-in mock instead (no backend needed):
# NEXT_PUBLIC_API_BASE_URL=/mock-api
# Mock only: accept orders at any time (ignores 10:00-16:00 and rush hour)
# MOCK_IGNORE_HOURS=true

# Uploads (payment slips, files to print) go to Supabase Storage:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
